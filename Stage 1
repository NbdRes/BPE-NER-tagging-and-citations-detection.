suppressWarnings({
  if (!requireNamespace("rstudioapi", quietly=TRUE)) install.packages("rstudioapi")
  if (!requireNamespace("sentencepiece", quietly=TRUE)) install.packages("sentencepiece")
})

library(rstudioapi)
library(sentencepiece)
library(tools)

cat("=== שלב 0: אימון BPE וקידוד כל הקורפוס ===\n\n")

# ===== 1. בחירת תיקיות =====
input_dir <- rstudioapi::selectDirectory(caption = "בחר תיקיית קבצים מקוריים (טקסט יווני)")
if (is.null(input_dir) || is.na(input_dir)) stop("לא נבחרה תיקייה.")

output_dir <- rstudioapi::selectDirectory(caption = "בחר תיקייה לשמירת תוצאות (תיקיית פרויקט)")
if (is.null(output_dir) || is.na(output_dir)) stop("לא נבחרה תיקייה.")

# יצירת תיקיות עבודה
bpe_encoded_dir <- file.path(output_dir, "bpe_encoded")
if (!dir.exists(bpe_encoded_dir)) dir.create(bpe_encoded_dir, recursive = TRUE)

# ===== 2. פרמטרים =====
BPE_SEP <- "\u25AA"  # ריבוע שחור
VOCAB_SIZE <- 5000
COVERAGE <- 0.9999

cat(sprintf("✓ תיקיית קלט: %s\n", basename(input_dir)))
cat(sprintf("✓ תיקיית פלט: %s\n", basename(output_dir)))
cat(sprintf("✓ גודל אוצר מילים: %d\n", VOCAB_SIZE))
cat(sprintf("✓ מפריד טוקנים: %s\n\n", BPE_SEP))

# ===== 3. הכנת קורפוס לאימון =====
cat("› אוסף קבצים לאימון BPE...\n")
all_files <- list.files(input_dir, pattern = "\\.txt$", full.names = TRUE, recursive = TRUE)

if (length(all_files) == 0) stop("❌ לא נמצאו קבצי .txt בתיקייה!")

cat(sprintf("✓ נמצאו %d קבצים\n", length(all_files)))

# יצירת קורפוס זמני לאימון
temp_dir <- file.path(output_dir, ".temp_bpe")
if (!dir.exists(temp_dir)) dir.create(temp_dir, recursive = TRUE)

corpus_path <- file.path(temp_dir, "training_corpus.txt")
model_name <- "greek_bpe"

cat("› בונה קורפוס אימון...\n")
corpus_con <- file(corpus_path, "w", encoding = "UTF-8")
for (f in all_files) {
  tryCatch({
    content <- readLines(f, warn = FALSE, encoding = "UTF-8")
    writeLines(content, corpus_con)
  }, error = function(e) {
    cat(sprintf("⚠ דילוג על %s: %s\n", basename(f), e$message))
  })
}
close(corpus_con)

cat(sprintf("✓ קורפוס נוצר: %s\n\n", basename(corpus_path)))

# ===== 4. אימון מודל BPE =====
cat("🚀 מאמן מודל BPE...\n")
cat("(זה יכול לקחת 10-30 דקות בהתאם לגודל הקורפוס)\n\n")

sentencepiece(
  x = corpus_path,
  type = "bpe",
  coverage = COVERAGE,
  vocab_size = VOCAB_SIZE,
  model_prefix = model_name,
  model_dir = temp_dir,
  verbose = FALSE
)

model_file <- file.path(temp_dir, paste0(model_name, ".model"))
if (!file.exists(model_file)) stop("❌ המודל לא נוצר!")

bpe_model <- sentencepiece_load_model(model_file)
cat("\n✓ מודל BPE אומן בהצלחה!\n\n")

# ===== 5. קידוד כל הקבצים =====
convert_file_to_bpe <- function(input_path, output_path, model) {
  tryCatch({
    raw_text <- readLines(input_path, warn = FALSE, encoding = "UTF-8")
    if (length(raw_text) == 0) return(NULL)
    
    full_text <- paste(raw_text, collapse = "\n")
    tokens <- sentencepiece_encode(full_text, model = model)
    
    encoded_text <- paste(tokens, collapse = BPE_SEP)
    writeLines(encoded_text, output_path, useBytes = TRUE)
    
  }, error = function(e) {
    cat(sprintf("⚠ שגיאה בקובץ %s: %s\n", basename(input_path), e$message))
  })
}

cat(sprintf("› מקודד %d קבצים...\n", length(all_files)))

# בדיקת קבצים שכבר עובדו (Resume)
done_files <- list.files(bpe_encoded_dir, pattern = "\\.txt$", full.names = FALSE)
target_files_todo <- all_files[!basename(all_files) %in% done_files]

if (length(target_files_todo) == 0) {
  cat("✓ כל הקבצים כבר עובדו!\n")
} else {
  pb <- txtProgressBar(min = 0, max = length(target_files_todo), style = 3)
  for (i in seq_along(target_files_todo)) {
    out_path <- file.path(bpe_encoded_dir, basename(target_files_todo[i]))
    convert_file_to_bpe(target_files_todo[i], out_path, bpe_model)
    setTxtProgressBar(pb, i)
  }
  close(pb)
}

# ===== 6. שמירת קונפיגורציה =====
config <- list(
  bpe_sep = BPE_SEP,
  vocab_size = VOCAB_SIZE,
  coverage = COVERAGE,
  model_file = model_file,
  input_dir = input_dir,
  bpe_encoded_dir = bpe_encoded_dir
)
saveRDS(config, file.path(output_dir, "config_bpe.rds"))

cat("\n\n🎉 שלב 0 הושלם בהצלחה!\n")
cat(sprintf("📁 קבצים מקודדים נשמרו ב: %s\n", basename(bpe_encoded_dir)))
cat(sprintf("⚙️ קונפיגורציה נשמרה: config_bpe.rds\n"))
cat("\n>>> עכשיו אפשר להריץ את שלב 2 (זיהוי התאמות)\n")
